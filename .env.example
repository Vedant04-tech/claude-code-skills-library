# ==============================================================================
# Environment Configuration Template for Claude Code Skills Library
# Copy this file to .env and fill in the values for the services you plan to use.
# None of these are required to start, but individual skills require their respective keys.
# ==============================================================================

# Core LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Lead Generation & Scraping (scrape-leads, gmaps-leads)
APIFY_API_TOKEN=your_apify_api_token_here

# Cold Email & Outreach Automation (instantly-campaigns, instantly-autoreply)
INSTANTLY_API_KEY=your_instantly_api_key_here

# Proposals & Sales (create-proposal)
PANDADOC_API_KEY=your_pandadoc_api_key_here

# Vector Search & RAG (skool-rag)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_env_here

# Persistent Vector Memory (vendor/claude-memory, memory-cloud-recall)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Headless Vercel Deployments (vercel-cli-with-tokens)
VERCEL_TOKEN=your_vercel_token_here

# Google Cloud OAuth (for Gmail and Google Sheets skills)
# Place credentials.json in the project root if using Google API workflows
